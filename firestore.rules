rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net: Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions for auth verification
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 1. Hotels Collection: Publicly readable for discovery, write-locked for admin/system
    match /hotels/{hotelId} {
      allow read: if true;
      allow write: if false; // System static or manually configured via server keys
    }

    // 2. Bookings Collection: Hardened owner-only reads and creation
    match /bookings/{bookingId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() 
                    && isValidId(bookingId) 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.totalPrice is number
                    && request.resource.data.totalPrice > 0;
      allow update, delete: if isSignedIn() 
                            && resource.data.userId == request.auth.uid 
                            && (request.resource == null || request.resource.data.userId == request.auth.uid);
    }

    // 3. Reviews: Public read, owner-only write
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() 
                    && isValidId(reviewId) 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.rating is number 
                    && request.resource.data.rating >= 1 
                    && request.resource.data.rating <= 5;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // 4. Trip Plans: Secured AI-generated custom itineraries
    match /tripPlans/{planId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() 
                    && isValidId(planId) 
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
